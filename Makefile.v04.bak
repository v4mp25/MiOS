ASM = nasm
CC = gcc
LD = ld

CFLAGS = -m32 -ffreestanding -fno-pie -fno-stack-protector -fno-asynchronous-unwind-tables -O0 -Wall -Wextra
LDFLAGS = -m elf_i386

all: os.iso

boot.o: boot/boot.asm
	$(ASM) -f elf32 $< -o $@

kernel.o: kernel/kernel.c
	$(CC) $(CFLAGS) -c $< -o $@

kernel.bin: boot.o kernel.o kernel/linker.ld
	$(LD) $(LDFLAGS) -T kernel/linker.ld -o $@ boot.o kernel.o

os.iso: kernel.bin boot/grub/grub.cfg
	mkdir -p iso/boot/grub
	cp kernel.bin iso/boot/kernel.bin
	cp boot/grub/grub.cfg iso/boot/grub/grub.cfg
	grub-mkrescue -o os.iso iso

run: os.iso
	qemu-system-i386 -cdrom os.iso -m 128M

clean:
	rm -f boot.o kernel.o kernel.bin os.iso
	rm -rf iso/boot

.PHONY: all run clean
